        <mxCell id="e9" value="1" style="endArrow=open;html=1;fontSize=11;" edge="1" parent="1" source="ItineraryDay" target="Meals">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="price" style="endArrow=open;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0;" edge="1" parent="1" source="Departure" target="Money">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
