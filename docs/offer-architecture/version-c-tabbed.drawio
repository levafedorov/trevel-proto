  <diagram id="c-nav" name="C · Модель навигации">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ntitle" value="Версия C — модель навигации (разделы строятся из наличия данных)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="820" height="30" as="geometry" />
        </mxCell>
        <mxCell id="navc" value="&lt;b&gt;SectionNav&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ visibleSections : SectionDescriptor[]&lt;br&gt;+ activeKey : string&lt;br&gt;+ scrollTo(anchor)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#bbf7d0;strokeColor=#16a34a;" vertex="1" parent="1">
          <mxGeometry x="120" y="90" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="&lt;b&gt;SectionDescriptor&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ key : string&lt;br&gt;+ anchor : string&lt;br&gt;+ label : LocalizedText&lt;br&gt;+ panel : Component&lt;br&gt;+ hasData : bool" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nnote" value="В меню попадают только разделы с hasData=true. Нет программы → нет вкладки «Программа». URL-хэш (#itinerary) открывает нужный раздел; хэш на скрытый раздел → мягкий fallback на первый доступный." style="text;html=1;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="680" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ne1" value="0..* показывает только hasData" style="endArrow=open;startArrow=diamondThin;startFill=0;html=1;fontSize=11;" edge="1" parent="1" source="navc" target="desc"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
